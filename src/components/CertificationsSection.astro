---
import CertificationCard from "./CertificationCard.astro"
import CertificateIcon from "./icons/CertificateIcon.astro"
import SchoolIcon from "./icons/SchoolIcon.astro"
import AWSIcon from "./icons/AWSIcon.astro"
import MetaIcon from "./icons/MetaIcon.astro"
import ReactIcon from "./icons/ReactIcon.astro"
import GitIcon from "./icons/GitIcon.astro"
import PythonIcon from "./icons/PythonIcon.astro"
import UXIcon from "./icons/UXIcon.astro"
import { certifications } from "../data/certifications"

const certIcons: Array<{ icon: any; provider?: any }> = [
  { icon: SchoolIcon },
  { icon: AWSIcon, provider: AWSIcon },
  { icon: ReactIcon, provider: MetaIcon },
  { icon: UXIcon, provider: MetaIcon },
  { icon: GitIcon, provider: MetaIcon },
  { icon: PythonIcon, provider: MetaIcon },
];
---

<section id="certifications" class="flex flex-col pt-20 lg:pt-36">
  <div class="flex mb-7 gap-x-6 items-center lg:mb-11 animate-on-scroll">
    <CertificateIcon class="size-12 text-gray-600 dark:text-white lg:size-14"/>
    <h2 class="font-bold text-5xl leading-normal bg-gradient-to-r from-purple-400 to-purple-600 bg-clip-text text-transparent lg:text-6xl lg:leading-normal">
      Certifications
    </h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
    {certifications.map((cert, i) => {
      const Icon = certIcons[i].icon;
      const ProviderIcon = certIcons[i].provider;
      return (
        <div class="animate-on-scroll" data-delay={i * 100}>
          <CertificationCard name={cert.name} provider={cert.provider} url={cert.url}>
            <Icon slot="icon" class="h-full" />
            {ProviderIcon && <ProviderIcon slot="provider" class="h-3" />}
          </CertificationCard>
        </div>
      );
    })}
  </div>
</section>
