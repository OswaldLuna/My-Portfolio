---
import NavLink from "./NavLink.astro"
import ThemeToggle from "./ThemeToggle"
import PersonIcon from "./icons/PersonIcon.astro"
import BriefcaseIcon from "./icons/BriefcaseIcon.astro"
import FoldersIcon from "./icons/FoldersIcon.astro"
import CertificateIcon from "./icons/CertificateIcon.astro"
---

<header
  class="fixed flex h-11 justify-center top-0 left-0 w-full z-10 px-6 bg-white/75 backdrop-blur-md
  dark:bg-black/75 md:px-9 lg:h-16"
>
  <nav class="flex justify-between items-center w-full max-w-[1200px]">
    <div class="flex items-center gap-x-5 md:gap-x-6">
      <NavLink href="#about-me" label="About Me">
        <PersonIcon slot="icon" class="size-5" />
      </NavLink>
      <NavLink href="#experience" label="Work Experience">
        <BriefcaseIcon slot="icon" class="size-5" />
      </NavLink>
      <NavLink href="#projects" label="Projects">
        <FoldersIcon slot="icon" class="size-5" />
      </NavLink>
      <NavLink href="#certifications" label="Certifications">
        <CertificateIcon slot="icon" class="size-5" />
      </NavLink>
    </div>
    <ThemeToggle client:idle />
  </nav>
</header>
