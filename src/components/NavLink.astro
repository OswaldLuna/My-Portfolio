---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  aria-label={label}
  class="flex items-center gap-x-1.5 text-purple-800 transition-colors duration-300 hover:text-purple-500
  focus-visible:outline-none focus-visible:text-purple-500
  dark:text-white/75 dark:hover:text-white dark:focus-visible:text-white"
>
  <span class="flex items-center justify-center">
    <slot name="icon" />
  </span>
  <span class="hidden md:inline hover:underline focus-visible:underline xl:text-lg">{label}</span>
</a>
